# Used with:  docker compose --env-file .env.docker up -d --build

# ---- Required ----
POSTGRES_PASSWORD=replace-with-a-strong-password
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
# The URL users open in the browser. In production behind HTTPS: https://harmoni.example.school
BETTER_AUTH_URL=http://localhost:3000

# ---- Optional ----
APP_PORT=3000
DB_PORT=5432
TEACHER_SIGNUP_CODE=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Harmoni Music Class <no-reply@example.com>"

# Production domain for the Caddy HTTPS proxy (docker compose --profile proxy)
DOMAIN=
