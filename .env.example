# ---- Required ----
# Secret used to sign sessions (at least 32 characters). Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Public URL of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# ---- Database ----
# Leave empty for local development: the app uses PGlite (embedded PostgreSQL) in ./data/pglite
# Set it for production, e.g.: postgres://user:pass@host:5432/harmoni
DATABASE_URL=

# ---- File storage ----
# "local" (default, stored in ./uploads) or "s3" (S3-compatible: AWS S3, Cloudflare R2, MinIO, Supabase Storage, ...)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---- AI (teachers only) ----
# The admin can also change these in the dashboard (AI Settings). A value saved there overrides this file.
# The API key is only ever read on the server. Without it the AI generator shows "AI is not enabled yet".
ANTHROPIC_API_KEY=
# Default model is claude-opus-5. Change it (e.g. claude-sonnet-5) to reduce cost.
AI_MODEL=claude-opus-5
# Automatic fallback when the model refuses a request (direct Claude API). Set "off" behind a proxy/Bedrock/Vertex.
AI_FALLBACK=on
# Maximum AI requests per teacher per day
AI_DAILY_LIMIT=50
# Which provider "auto" uses: auto | claude-cli | anthropic | gemini | ollama. Teachers can also pick one in the UI.
# auto = Claude Code (`claude`, logged in on the server) when installed, then ANTHROPIC_API_KEY, then GEMINI_API_KEY, then a running Ollama.
AI_PROVIDER=auto
# Optional model for the Claude Code CLI (empty = its default)
AI_CLI_MODEL=
# Ollama (local models, no key). "auto" uses it last, when its server answers. In Docker use http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=qwen2.5:3b

# Gemini API (Google AI Studio key). GOOGLE_API_KEY also works.
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash

# ---- Google sign-in (optional) ----
# Without both, "Continue with Google" is hidden; self-registration stays email/password only.
# Authorized redirect URI in the Google Cloud OAuth client: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (Forgot password) ----
# Without SMTP, the password reset link is printed in the server log (enough for development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Harmoni Music Class <no-reply@example.com>"

# ---- Optional ----
# When set, registering a teacher account requires this code (prevents strangers from signing up as teachers).
TEACHER_SIGNUP_CODE=
