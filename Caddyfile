# Reverse proxy + automatic HTTPS (Let's Encrypt) for the app.
# Only used by the "caddy" service (profile "proxy") in docker-compose.yml.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Harmoni Gitar (repo terpisah, /opt/harmoni-gitar di VPS). App-nya membuka port 3001 di 172.17.0.1
# (jembatan docker0), yang bisa dijangkau Caddy ini tanpa berbagi network Docker.
harmoniclass.tech {
	encode zstd gzip
	reverse_proxy 172.17.0.1:3001
}

www.harmoniclass.tech {
	redir https://harmoniclass.tech{uri} permanent
}
